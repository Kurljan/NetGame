      },
      {
        "id": "l-3", "sourceDeviceId": "sw-1", "sourceInterface": "FastEthernet0/1",
        "destDeviceId": "pc-2", "destInterface": "FastEthernet0", "type": "ethernet", "status": "up"
      },
      {
        "id": "l-4", "sourceDeviceId": "sw-1", "sourceInterface": "FastEthernet0/2",
