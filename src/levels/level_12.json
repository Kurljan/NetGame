    { "id": "obj3", "desc": "R3 has route to 10.1.0.0/24 via 10.2.0.1" },
    { "id": "obj4", "desc": "PC1 can ping PC-Remote (10.3.0.10)" }
  ],
  "requirements": [
    { "id": "obj1", "type": "ping", "desc": "PC1 → 10.2.0.2 (R2 G0/0)", "srcDeviceId": "pc-12a", "dstIp": "10.2.0.2" },
    { "id": "obj2", "type": "subnet", "desc": "R2 G0/1 in 10.2.0.0/30", "hostname": "R2", "interface": "G0/1", "expectedNetwork": "10.2.0.0", "expectedMask": "255.255.255.252" },
    { "id": "obj3", "type": "route-exists", "desc": "R3 has route to 10.1.0.0/24", "hostname": "R3", "network": "10.1.0.0", "mask": "255.255.255.0" },
    { "id": "obj4", "type": "ping", "desc": "PC1 → PC-Remote full path", "srcDeviceId": "pc-12a", "dstIp": "10.3.0.10" }
  ],
  "hints": [
    "Run traceroute 10.3.0.10 on PC1 to see where it fails.",
    "ICMP uses the Network Layer (L3) — no ports, just echo request/reply.",
    "Check R2's interfaces: G0/0 should be 10.1.0.2/30, G0/1 should be 10.2.0.2/30 — one is wrong!",
    "Fix R2's broken interface, then add static routes so R1 and R3 can forward traffic.",
    "R1 needs: ip route 10.3.0.0 255.255.255.0 10.1.0.2",
    "R3 needs: ip route 10.1.0.0 255.255.255.0 10.2.0.1"
  ],
