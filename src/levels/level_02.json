{
  "id": 2,
  "title": "Subnetting Challenge",
  "topic": "Subnetting / VLSM",
  "description": "Divide the 192.168.10.0/24 address space into two equal /25 subnets. Assign one subnet to the left LAN and one to the right LAN. Use the Subnet Calculator (bottom right button) to help.",
  "ccnaRef": "CCNA ITN: Chapter 9 – Subnetting IP Networks",
  "sandboxMode": false,
  "objectives": [
    { "id": "obj1", "desc": "PC1 is in subnet 192.168.10.0/25" },
    { "id": "obj2", "desc": "PC2 is in subnet 192.168.10.128/25" },
    { "id": "obj3", "desc": "PC1 can ping PC1B (same subnet)" },
    { "id": "obj4", "desc": "PC2 can ping PC2B (same subnet)" }
  ],
  "requirements": [
    {
      "id": "obj1",
      "type": "subnet",
      "desc": "PC1 is in 192.168.10.0/25",
      "hostname": "PC1",
      "interface": "Fa0",
      "expectedNetwork": "192.168.10.0",
      "expectedMask": "255.255.255.128"
    },
    {
      "id": "obj2",
      "type": "subnet",
      "desc": "PC2 is in 192.168.10.128/25",
      "hostname": "PC2",
      "interface": "Fa0",
      "expectedNetwork": "192.168.10.128",
      "expectedMask": "255.255.255.128"
    },
    {
      "id": "obj3",
      "type": "ping",
      "desc": "PC1 → PC1B ping succeeds",
      "srcDeviceId": "pc-3",
      "dstIp": "192.168.10.2"
    },
    {
      "id": "obj4",
      "type": "ping",
      "desc": "PC2 → PC2B ping succeeds",
      "srcDeviceId": "pc-5",
      "dstIp": "192.168.10.130"
    }
  ],
  "hints": [
    "192.168.10.0/24 has 256 addresses. Splitting into /25 gives two blocks of 128.",
    "Subnet 1: 192.168.10.0 – 192.168.10.127  (mask: 255.255.255.128)",
    "Subnet 2: 192.168.10.128 – 192.168.10.255  (mask: 255.255.255.128)",
    "Use the Subnet Calculator button to verify your subnets."
  ],
  "topology": {
    "devices": [
      { "id": "pc-3",  "type": "pc", "hostname": "PC1",  "x": 160, "y": 280, "interfaces": [{ "name": "FastEthernet0", "shortName": "Fa0", "status": "up", "ipAddress": "", "subnetMask": "", "macAddress": "AA:BB:CC:01:00:01" }], "config": {} },
      { "id": "pc-4",  "type": "pc", "hostname": "PC1B", "x": 160, "y": 380, "interfaces": [{ "name": "FastEthernet0", "shortName": "Fa0", "status": "up", "ipAddress": "192.168.10.2", "subnetMask": "255.255.255.128", "macAddress": "AA:BB:CC:01:00:02" }], "config": {} },
      { "id": "sw-2",  "type": "switch", "hostname": "SW-Left", "x": 380, "y": 330, "interfaces": [{ "name": "FastEthernet0/0", "shortName": "Fa0/0", "status": "up", "vlanId": 1 }, { "name": "FastEthernet0/1", "shortName": "Fa0/1", "status": "up", "vlanId": 1 }], "vlans": [{ "id": 1, "name": "default" }], "config": {} },
      { "id": "sw-3",  "type": "switch", "hostname": "SW-Right","x": 680, "y": 330, "interfaces": [{ "name": "FastEthernet0/0", "shortName": "Fa0/0", "status": "up", "vlanId": 1 }, { "name": "FastEthernet0/1", "shortName": "Fa0/1", "status": "up", "vlanId": 1 }], "vlans": [{ "id": 1, "name": "default" }], "config": {} },
      { "id": "pc-5",  "type": "pc", "hostname": "PC2",  "x": 900, "y": 280, "interfaces": [{ "name": "FastEthernet0", "shortName": "Fa0", "status": "up", "ipAddress": "", "subnetMask": "", "macAddress": "AA:BB:CC:02:00:01" }], "config": {} },
      { "id": "pc-6",  "type": "pc", "hostname": "PC2B", "x": 900, "y": 380, "interfaces": [{ "name": "FastEthernet0", "shortName": "Fa0", "status": "up", "ipAddress": "192.168.10.130", "subnetMask": "255.255.255.128", "macAddress": "AA:BB:CC:02:00:02" }], "config": {} }
    ],
    "links": [
      { "id": "l-1", "sourceDeviceId": "pc-3",  "sourceInterface": "FastEthernet0",    "destDeviceId": "sw-2",  "destInterface": "FastEthernet0/0", "type": "ethernet", "status": "up" },
      { "id": "l-2", "sourceDeviceId": "pc-4",  "sourceInterface": "FastEthernet0",    "destDeviceId": "sw-2",  "destInterface": "FastEthernet0/1", "type": "ethernet", "status": "up" },
      { "id": "l-3", "sourceDeviceId": "pc-5",  "sourceInterface": "FastEthernet0",    "destDeviceId": "sw-3",  "destInterface": "FastEthernet0/0", "type": "ethernet", "status": "up" },
      { "id": "l-4", "sourceDeviceId": "pc-6",  "sourceInterface": "FastEthernet0",    "destDeviceId": "sw-3",  "destInterface": "FastEthernet0/1", "type": "ethernet", "status": "up" }
    ]
  }
}
